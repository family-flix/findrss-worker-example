{
  "name": "findrss-worker",
  "version": "1.0.0",
  "description": "可自行部署到 Cloudflare Workers 的爬虫脚本平台，用于创建 RSS / Atom 订阅源",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "node scripts/dev.js",
    "deploy": "npm run build && wrangler deploy",
    "dry-run": "npm run build && wrangler deploy --dry-run",
    "test": "node --test test/*.test.js admin/__tests__/*.test.mjs && node --test discover/test/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@findrss/feed-fetch": "file:./packages/feed-fetch",
    "@findrss/object-store": "file:./packages/object-store",
    "@jitl/quickjs-wasmfile-release-asyncify": "^0.32.0",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/webp": "^1.5.0",
    "blurhash": "^2.0.5",
    "codemirror": "^5.65.21",
    "csso": "^5.0.5",
    "esbuild": "^0.28.2",
    "fast-xml-parser": "^4.5.7",
    "js-beautify": "^2.0.3",
    "node-html-parser": "^9.0.4",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.6",
    "quickjs-emscripten-core": "^0.32.0"
  },
  "private": true,
  "devDependencies": {
    "wrangler": "^4.135.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "cloudflare": {
    "bindings": {
      "ADMIN_PASSWORD": {
        "description": "管理后台登录密码，请设置随机长密码。"
      }
    }
  }
}
