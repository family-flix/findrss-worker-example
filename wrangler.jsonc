{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "findrss-worker",
  "main": "index.js",
  "assets": {
    "directory": "./dist/assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": [
      "/",
      "/index.html",
      "/admin",
      "/admin/*",
      "/api/*",
      "/discovery/*",
      "/public",
      "/public/*",
      "/clips/*",
      "/health",
      "/mcp",
      "/oauth/*",
      "/.well-known/oauth-protected-resource",
      "/.well-known/oauth-protected-resource/*",
      "/.well-known/oauth-authorization-server",
      "/v1",
      "/v1/*",
      "/reader/*",
      "/rss/*",
      "/atom/*",
      "/debug/*",
      "/_internal/*",
      "/_admin/*",
      "/wxmpimgproxy",
      "/findrss-logo.png"
    ]
  },
  "alias": {
    "timeless": "./public/assets/timeless/0.34.2/timeless.lite.esm.js",
    "timeless-ssr": "./public/assets/timeless/0.34.2/timeless.ssr.esm.js"
  },
  "compatibility_date": "2026-05-03",
  "compatibility_flags": ["nodejs_compat"],
  "browser": {
    "binding": "BROWSER"
  },
  // 两类业务日志由 Workers Logs 保存；关闭额外请求日志，避免设备心跳重复计数。
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false
    }
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.css",
        "**/*.svg"
      ],
      "fallthrough": true
    },
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ],
      "fallthrough": false
    }
  ],
  // R2 对象存储桶，由 Wrangler 统一部署。
  "r2_buckets": [
    {
      "binding": "API_STORAGE",
      "bucket_name": "findrss-storage"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "API",
        "class_name": "APIDurableObject"
      }
    ]
  },
  "exports": {
    "APIDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "HubDurableObject": {
      "type": "durable-object",
      "state": "deleted"
    },
    "BridgeDurableObject": {
      "type": "durable-object",
      "state": "deleted"
    }
  },
  "secrets": {
    "required": [
      "ADMIN_PASSWORD"
    ]
  }
}
